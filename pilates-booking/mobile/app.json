{
  "expo": {
    "name": "Pilates Booking",
    "slug": "pilates-booking",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilays_apps.pilatesbooking",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "he"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "com.ilays_apps.pilatesbooking",
      "allowBackup": true,
      "supportsRtl": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "googleServicesFile": "./android/app/google-services.json"
    },
    "web": {},
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "pilates",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "ac738aaf-0f9c-4512-aa87-9f26071bfbbc"
      },
      "firebase": {
        "projectId": "pilates-app-98b07",
        "appId": "1:581407140324:android:b0d1a9741ee99d34efbff1",
        "messagingSenderId": "581407140324"
      }
    },
    "owner": "ilaylavy"
  }
}
