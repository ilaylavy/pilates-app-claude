{
  "expo": {
    "name": "Pilates Booking",
    "slug": "pilates-booking",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.pilatesbooking",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "he"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "com.yourcompany.pilatesbooking",
      "allowBackup": true,
      "supportsRtl": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {},
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-localization"
    ],
    "scheme": "pilates",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "ac738aaf-0f9c-4512-aa87-9f26071bfbbc"
      }
    },
    "owner": "ilaylavy"
  }
}
